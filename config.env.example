# Copy to config.env on the server and fill in the paths:
#   cp config.env.example config.env
# config.env is gitignored, so server paths never reach the repo.

# --- storage (keep heavy files out of $HOME) ---------------------------------
STORAGE_ROOT="/path/to/your/storage"          # personal folder for envs and caches
SHARED_HUB=""                                 # optional team-shared HF hub (".../huggingface/hub"); empty = download into HF_HOME
HF_HOME="$STORAGE_ROOT/cache/huggingface"     # personal: token, xet cache, hub/
PIP_CACHE_DIR="$STORAGE_ROOT/cache/pip"
TORCH_HOME="$STORAGE_ROOT/cache/torch"

# --- python env --------------------------------------------------------------
CONDA_ENV="embed"
PYTHON_VERSION="3.11"
TORCH_CUDA=""            # e.g. "cu129"; empty = pick from the driver's CUDA version in nvidia-smi

# --- GPU / network -----------------------------------------------------------
GPU_INDEX="0"            # nvidia-smi index of the GPU to use (PCI bus order)
HOST="127.0.0.1"         # keep on localhost and reach it through an SSH tunnel
PORT="8001"

# --- models ------------------------------------------------------------------
EMBED_MODEL="BAAI/bge-m3"
RERANK_MODEL="BAAI/bge-reranker-v2-m3"
MAX_EMB_LEN="8192"       # bge-m3 max context
MAX_RR_LEN="1024"        # query + passage tokens per pair (model supports up to 8192)
EMB_BATCH="16"           # lower if long inputs OOM
RR_BATCH="32"
USE_FP16="1"             # 0 = fp32 (only for very old GPUs with slow fp16)
MAX_INPUTS="2048"        # max texts / documents per request

# --- runtime -----------------------------------------------------------------
API_KEY_FILE="$HOME/.embed_api_key"   # generated on first start, chmod 600
LOG_DIR="$ROOT/logs"
